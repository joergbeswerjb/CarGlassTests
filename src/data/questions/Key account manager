// Целевой профиль KAM: D + I + сильный C, S умеренная.
// D — драйв и ownership; I — доверенный переговорщик и коммуникатор;
// C — считает маржу и держит цифры (НЕ в подвале — ключевой риск-флаг);
// S — держит отношения долгосрочно, но не пассивен.
export const DISC_TARGETS = {
  D: { min: 55, max: 100, label: 'Драйв и ownership — гонит результат, берёт ответственность' },
  I: { min: 50, max: 100, label: 'Влияние — доверенный переговорщик, коммуникация на всех уровнях' },
  S: { min: 20, max:  65, label: 'Умеренная — держит отношения, но не пассивен' },
  C: { min: 50, max: 100, label: 'Заметная — считает маржу и держит цифры; НЕ в подвале' },
}

// Ведущая должна быть D или I (охотник/закрывающий). Проверка МЯГКАЯ.
// C-ведущий (аналитик без драйва) или S-ведущий (пассивный) — «профиль смещён»,
// флаг + ниже ранг, не провал. alsoAcceptable обрабатывается в calcDiscKAM.
export const DISC_DOMINANT_ORDER = {
  primary:         'D',
  alsoAcceptable:  ['I'],
  demoteIfPrimary: ['S', 'C'],
  soft:            true,
}

